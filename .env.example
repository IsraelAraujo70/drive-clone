# drive-clone environment reference. Copy to .env and adjust as needed.

# --- API (services/api) ---
HOST=0.0.0.0
PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5433/drive_clone
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Object storage (S3-compatible, e.g. MinIO)
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=drive-clone
S3_REGION=us-east-1
S3_URL_STYLE=path
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# Upload limits and presigned URL lifetimes
MAX_FILE_SIZE_BYTES=16106127360
PRESIGNED_URL_TTL_SECONDS=900
RESUMABLE_UPLOAD_TTL_SECONDS=86400

# Base URL of the public web app, used to build share-link URLs ({PUBLIC_WEB_URL}/s/{token}).
PUBLIC_WEB_URL=http://localhost:3000

# Worker jobs
TRASH_RETENTION_DAYS=30
WORKER_INTERVAL_SECONDS=300

# --- Web (apps/web) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
