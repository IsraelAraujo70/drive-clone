meta {
  name: Forgot Password
  type: http
  seq: 4
}
post {
  url: {{baseUrl}}/auth/password/forgot
  body: json
  auth: none
}
headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "email": "{{resetEmail}}"
  }
}

tests {
  test("response status is documented", function() {
    expect([204, 422, 502]).to.include(res.status);
  });
}

docs {
  Requests a one-hour password reset link. Unknown email still returns 204 so account existence is not leaked.
}
