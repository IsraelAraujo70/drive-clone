meta {
  name: Login
  type: http
  seq: 2
}
post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}
headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "email": "{{loginEmail}}",
    "password": "{{loginPassword}}"
  }
}

tests {
  if (res.body && res.body.token) {
    bru.setVar('authToken', res.body.token);
  }
  if (res.body && res.body.user && res.body.user.id) {
    bru.setVar('userId', res.body.user.id);
  }

  test("response status is documented", function() {
    expect([200, 401]).to.include(res.status);
  });
}

docs {
  Authenticates an existing user. Unknown email and wrong password both return invalid_credentials. Saves token and user id to the active environment.
}
