meta {
  name: Reset Password
  type: http
  seq: 5
}
post {
  url: {{baseUrl}}/auth/password/reset
  body: json
  auth: none
}
headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "token": "{{resetToken}}",
    "password": "{{resetPassword}}"
  }
}

tests {
  test("response status is documented", function() {
    expect([204, 422]).to.include(res.status);
  });
}

docs {
  Consumes a password reset token, changes the password, and revokes existing sessions.
}
