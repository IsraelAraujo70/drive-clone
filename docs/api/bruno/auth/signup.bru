meta {
  name: Signup
  type: http
  seq: 1
}
post {
  url: {{baseUrl}}/auth/signup
  body: json
  auth: none
}
headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "email": "{{signupEmail}}",
    "password": "{{signupPassword}}",
    "display_name": "{{signupDisplayName}}"
  }
}

tests {
  if (res.body && res.body.token) {
    bru.setVar('authToken', res.body.token);
  }
  if (res.body && res.body.user && res.body.user.id) {
    bru.setVar('userId', res.body.user.id);
  }

  test("response status is documented", function() {
    expect(res.status).to.equal(201);
    expect(res.body).to.have.property('token');
  });
}

docs {
  Creates an account and session. Email is trimmed/lowercased; password must be 8-128 chars. Saves token and user id to the active environment.
}
