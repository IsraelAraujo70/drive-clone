meta {
  name: Drive Trash
  type: http
  seq: 5
}
get {
  url: {{baseUrl}}/drive/trash
  body: none
  auth: bearer
}
auth:bearer {
  token: {{authToken}}
}

headers {
  Accept: application/json
}

tests {
  test("response status is documented", function() {
    expect([200, 401]).to.include(res.status);
  });
}

docs {
  Returns top-level trash entries for folders and files owned by the authenticated user.
}
