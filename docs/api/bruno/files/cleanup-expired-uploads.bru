meta {
  name: Cleanup Expired Uploads
  type: http
  seq: 11
}
post {
  url: {{baseUrl}}/files/uploads/cleanup-expired
  body: none
  auth: bearer
}
auth:bearer {
  token: {{authToken}}
}

headers {
  Accept: application/json
}

tests {
  test("response status is documented", function() {
    expect([200, 401, 502]).to.include(res.status);
  });
}

docs {
  Expires stale pending resumable uploads and aborts their multipart uploads in object storage.
}
