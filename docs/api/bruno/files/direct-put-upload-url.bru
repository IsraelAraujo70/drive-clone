body:text {
hello bruno
}

tests {
  test("response status is documented", function() {
    expect([200, 201, 204, 403]).to.include(res.status);
  });
}

docs {
  Uploads raw bytes to the presigned object-storage URL returned by Create Upload. This is not authenticated by the API bearer token.
}
