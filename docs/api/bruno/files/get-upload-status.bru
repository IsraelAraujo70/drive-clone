meta {
  name: Get Upload Status
  type: http
  seq: 5
}
get {
  url: {{baseUrl}}/files/uploads/{{fileId}}/status
  body: none
  auth: bearer
}
auth:bearer {
  token: {{authToken}}
}

headers {
  Accept: application/json
}

tests {
  test("response status is documented", function() {
    expect([200, 401, 404]).to.include(res.status);
  });
}

docs {
  Returns resumable upload state and confirmed parts so clients can resume from server state.
}
