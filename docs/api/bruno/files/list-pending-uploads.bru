meta {
  name: List Pending Uploads
  type: http
  seq: 6
}
get {
  url: {{baseUrl}}/files/uploads/pending
  body: none
  auth: bearer
}
auth:bearer {
  token: {{authToken}}
}

headers {
  Accept: application/json
}

tests {
  test("response status is documented", function() {
    expect([200, 401]).to.include(res.status);
  });
}

docs {
  Lists the caller's own pending, non-expired resumable sessions so the client can recover interrupted uploads. The server is authoritative for existence and expiration.
}
