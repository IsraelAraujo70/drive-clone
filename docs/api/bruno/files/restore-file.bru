meta {
  name: Restore File
  type: http
  seq: 15
}
post {
  url: {{baseUrl}}/files/{{fileId}}/restore
  body: none
  auth: bearer
}
auth:bearer {
  token: {{authToken}}
}

headers {
  Accept: application/json
}

tests {
  test("response status is documented", function() {
    expect([200, 401, 404]).to.include(res.status);
  });
}

docs {
  Owner-only restore for a file directly deleted by the owner. Clears deleted_at when the parent folder is active.
}
