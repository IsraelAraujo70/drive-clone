meta {
  name: List Share Links
  type: http
  seq: 2
}
get {
  url: {{baseUrl}}/files/{{fileId}}/share-links
  body: none
  auth: bearer
}
auth:bearer {
  token: {{authToken}}
}

headers {
  Accept: application/json
}

tests {
  test("response status is documented", function() {
    expect([200, 401, 404]).to.include(res.status);
  });
}

docs {
  Owner-only list of the file's share links. Tokens are never returned; each entry carries id, created_at, expires_at, and revoked_at.
}
