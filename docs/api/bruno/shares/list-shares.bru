meta {
  name: List Shares
  type: http
  seq: 2
}
get {
  url: {{baseUrl}}/files/{{fileId}}/shares
  body: none
  auth: bearer
}
auth:bearer {
  token: {{authToken}}
}

headers {
  Accept: application/json
}

tests {
  test("response status is documented", function() {
    expect([200, 401, 404]).to.include(res.status);
  });
}

docs {
  Owner-only list of current grantees for a file.
}
