# Local development values (docker-compose Postgres on host port 5433)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/drive_clone
PORT=8080
# Comma-separated list. Add the actual web dev origin if using another port.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# S3-compatible object storage. docker-compose runs MinIO internally at minio:9000
# and exposes it to browsers on localhost:9000.
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=drive-clone
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
MAX_FILE_SIZE_BYTES=16106127360
PRESIGNED_URL_TTL_SECONDS=900
