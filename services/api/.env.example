# Local development values (docker-compose Postgres on host port 5433)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/drive_clone
PORT=8080
# Comma-separated list. Add the actual web dev origin if using another port.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# S3-compatible object storage. docker-compose runs MinIO internally at minio:9000
# and exposes it to browsers on localhost:9000.
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=drive-clone
S3_REGION=us-east-1
S3_URL_STYLE=path
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
MAX_FILE_SIZE_BYTES=16106127360
# TTL for a single presigned upload/download URL (short-lived; per part).
PRESIGNED_URL_TTL_SECONDS=900
# Lifetime of a whole resumable upload session, decoupled from the presigned URL
# TTL so large multi-part uploads survive across many part URLs. Default 24h.
RESUMABLE_UPLOAD_TTL_SECONDS=86400
TRASH_RETENTION_DAYS=30
WORKER_INTERVAL_SECONDS=300
